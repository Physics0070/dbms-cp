# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file connected at startup. You can also switch files from the UI at runtime.
DATABASE_PATH=optimizer_demo.db
# The database is opened READ-ONLY unless this is true. Enabling it allows the
# "Create index" action in the Index advisor.
ALLOW_INDEX_CREATION=false

# ---------------------------------------------------------------------------
# OpenAI (AI Copilot). Optional — the optimizer works fully without it.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_S=45

# ---------------------------------------------------------------------------
# Deterministic demo-data seed generation
# ---------------------------------------------------------------------------
SEED=42
CUSTOMER_COUNT=2000
ORDER_COUNT=8000
PRODUCT_COUNT=500

# ---------------------------------------------------------------------------
# Optimizer tunables (defaults; every "magic number" is configurable)
# ---------------------------------------------------------------------------
# Cost of reading one page/row from disk vs. processing one row in CPU.
COST_IO_PER_PAGE=1.0
COST_CPU_PER_ROW=0.01
COST_CPU_PER_OPERATOR=0.0025
# Rows assumed per page (for I/O page estimation).
ROWS_PER_PAGE=100
# Default selectivity fallbacks when statistics are unavailable.
DEFAULT_EQ_SELECTIVITY=0.1
DEFAULT_RANGE_SELECTIVITY=0.3333
DEFAULT_JOIN_SELECTIVITY=0.1
# Statistics cache TTL in seconds.
STATS_CACHE_TTL=300
# Statistics collection: most-common-values kept per column, and when a column is
# low-cardinality enough to histogram (<= MCV_MIN_DISTINCT_CAP values, or <= this
# fraction of the row count).
MCV_LIMIT=10
MCV_MIN_DISTINCT_CAP=50
MCV_DISTINCT_RATIO=0.05
# Plan search: <= N relations are enumerated exhaustively, more use System-R DP.
EXHAUSTIVE_JOIN_THRESHOLD=6
MAX_CANDIDATES=12
# Benchmarking and rewrite verification.
BENCHMARK_WARMUP=2
BENCHMARK_RUNS=5
EQUIVALENCE_ROW_CAP=50000
# A rewrite must beat the query as written by at least this estimated percentage.
MIN_ESTIMATED_GAIN_PCT=0.5
HISTORY_LIMIT=200
# Where query history is stored (empty = backend/query_history.json).
HISTORY_PATH=
# How many example queries to generate from the schema.
EXAMPLE_LIMIT=6
OPTIMIZER_VERSION=1.1.0

# Comma-separated browser origins allowed to call the API (add your domain when deploying).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
