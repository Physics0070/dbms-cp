# ---------------------------------------------------------------------------
# Turso / libSQL connection
# ---------------------------------------------------------------------------
# Remote Turso database URL, e.g. libsql://your-db-name.turso.io
# Leave BLANK to use a local libSQL/SQLite file (great for development/tests).
TURSO_DATABASE_URL=
# Auth token for the remote Turso database. Only required when TURSO_DATABASE_URL is set.
TURSO_AUTH_TOKEN=

# Local database file used when TURSO_DATABASE_URL is empty.
LOCAL_DB_PATH=optimizer_demo.db

# ---------------------------------------------------------------------------
# OpenAI (AI Copilot). Optional — the optimizer works fully without it.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Deterministic demo-data seed generation
# ---------------------------------------------------------------------------
SEED=42
CUSTOMER_COUNT=2000
ORDER_COUNT=8000
PRODUCT_COUNT=500

# ---------------------------------------------------------------------------
# Optimizer tunables (defaults; every "magic number" is configurable)
# ---------------------------------------------------------------------------
# Cost of reading one page/row from disk vs. processing one row in CPU.
COST_IO_PER_PAGE=1.0
COST_CPU_PER_ROW=0.01
COST_CPU_PER_OPERATOR=0.0025
# Rows assumed per page (for I/O page estimation).
ROWS_PER_PAGE=100
# Default selectivity fallbacks when statistics are unavailable.
DEFAULT_EQ_SELECTIVITY=0.1
DEFAULT_RANGE_SELECTIVITY=0.3333
DEFAULT_JOIN_SELECTIVITY=0.1
# Statistics cache TTL in seconds.
STATS_CACHE_TTL=300

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
